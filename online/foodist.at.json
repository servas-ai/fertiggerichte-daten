    /*
     * Both the hidden default and the reveal live here, unlayered and WITHOUT !important,
     * on purpose.
     *
     * Tailwind's `hidden` cannot do the default: base.css sets `display: inline-flex` on
     * `.button` and is unlayered, which beats `.hidden` in @layer utilities. And `!hidden`
     * cannot be revealed: for !important declarations the cascade inverts the layer order,
     * so a layered `display:none!important` beats an unlayered one — the twin CTA would
     * stay invisible in Variation 2.
     *
     * Plain rules from this block settle both cleanly: it renders inside <body>, after the
     * head stylesheets, so at equal specificity it wins over `.button`; and the reveal
     * selectors are more specific than the defaults.
     */
    [data-mnr725-v1],
    [data-mnr725-v2-cta] {
      display: none;
    }
    /*
     * Every hide is guarded by `:has()`, so it can only apply while its replacement is
     * actually on the page.
     *
     * Without the guard: `html[data-mnr725-variant]` is set once and survives every
     * re-render, but the twin CTA below only renders while the cart holds an unavailable
     * line. Clear the last one — which is exactly what this experiment asks people to do —
     * and Variation 2 was left with the real checkout button hidden and no twin to replace
     * it. A cart with no way to check out at all. Same reasoning for Variation 1's warning
     * and for the grey CTA further down.
     */
    html[data-mnr725-variant='1'] .cart__ctas:has([data-mnr725-v1]) #CartDrawer-ErrorMessage,
    html[data-mnr725-variant='2'] .cart__ctas:has([data-mnr725-v2-cta]) #CartDrawer-ErrorMessage,
    html[data-mnr725-variant='2'] .cart__ctas:has([data-mnr725-v2-cta]) #CartDrawer-Checkout {
      display: none;
    }
    html[data-mnr725-variant='1'] [data-mnr725-v1] {
      display: block;
    }

    /*
     * Variation 2 hides the Control warning because the modal takes over that messaging — but
     * the drawer's error block also carries reasons that have nothing to do with this test
     * (purchase limits, `onlythis`). When the modal hands off to a checkout button the
     * storefront still refuses, the component sets this flag and the real reason becomes
     * visible again. The extra attribute outweighs the rule that hid it.
     */
    html[data-mnr725-variant='2'][data-mnr725-blocked] .cart__ctas:has([data-mnr725-v2-cta]) #CartDrawer-ErrorMessage {
      display: block;
    }
    html[data-mnr725-variant='2'] [data-mnr725-v2-cta] {
      display: inline-flex;
    }

    /*
     * The remove control has to stay inside the sentence. `.cart__ctas button { width: 100% }`
     * (component-cart.css) applies to every button in this block and would push it onto its
     * own line; two classes beat that selector's class+type.
     */
    .cart__ctas .mnr725-remove-link {
      display: inline;
      width: auto;
      min-width: 0;
      min-height: 0;
      height: auto;
      text-align: left;
    }

    /*
     * Variation 1 greys the (still disabled) checkout CTA, so the remove link is the obvious
     * next step. Guarded like the rules above, so the button returns to the default green the
     * moment the last unavailable line is gone.
     */
    html[data-mnr725-variant='1'] .cart__ctas:has([data-mnr725-v1]) #CartDrawer-Checkout {
      background-color: #696c78;
      border-color: #696c78;
      color: #fff;
    }
  </style>
