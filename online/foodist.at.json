<script>
  (function() {
    var FLOW = '[magnamate-flow]';
    var loaderSrc = 'https://app.magnamate.de/chatbot-loader.js';

    function loadChatbotWithId(chatbotId, agentUrl) {
      if (!chatbotId) {
        console.log(FLOW + ' theme loadChatbotWithId skip chatbotId empty');
        return;
      }
      console.log(FLOW + ' theme loadChatbotWithId chatbotId=' + chatbotId);
      var existingScript = document.querySelector('script[src*="chatbot-loader.js"]');
      if (existingScript) existingScript.remove();
      var existingHost = document.getElementById('magnamate-widget-host');
      if (existingHost) existingHost.remove();
      var script = document.createElement('script');
      script.src = loaderSrc;
      script.setAttribute('data-chatbot-id', chatbotId);
      if (agentUrl) script.setAttribute('data-agent-url', agentUrl);
      script.defer = true;
      document.body.appendChild(script);
    }

    // MAGNA-710: CMP consent gate for the app-embed. The static snippet gates
    // itself via `type="text/plain" data-usercentrics` markup-blocking, but this
    // app-embed injects the loader with createElement+appendChild which CMP
    // markup-blocking cannot intercept. So when cmpEmbed is enabled we gate the
    // inject ourselves: load only after consent (Shopify Customer Privacy API is
    // the primary/proven source; Usercentrics is a backup keyed by serviceName).
    // Fail-closed — if consent never comes, the widget never loads (matches the
    // static path, where an un-consented text/plain tag never executes).
    // Gate ONLY on an EXPLICIT consent decision (currentVisitorConsent
    // marketing/analytics === 'yes'), mirroring the proven in-widget
    // ConsentDetector. Do NOT use analyticsProcessingAllowed()/marketingAllowed():
    // those return true BY DEFAULT for any region the merchant hasn't marked
    // "regulated" in Shopify's native privacy settings — which a Usercentrics-only
    // merchant never configures — so trusting them would fail the gate OPEN (load
    // with zero consent) for exactly this ticket's target merchants (MAGNA-710).
    function isShopifyConsented() {
      try {
        var sp = window.Shopify && window.Shopify.customerPrivacy;
        if (sp && typeof sp.currentVisitorConsent === 'function') {
          var c = sp.currentVisitorConsent();
          if (c && (c.marketing === 'yes' || c.analytics === 'yes')) return true;
        }
      } catch (e) {}
      return false;
    }

    // Usercentrics v2 (window.UC_UI) — synchronous read by Data Processing
    // Service name (the same value used in the static data-usercentrics attr).
    function isUsercentricsConsented(serviceName) {
      if (!serviceName) return false;
      try {
        var ui = window.UC_UI;
        if (ui && typeof ui.getServicesBaseInfo === 'function') {
          var list = ui.getServicesBaseInfo() || [];
          for (var i = 0; i < list.length; i++) {
            var s = list[i];
            if (s && s.name === serviceName && s.consent && s.consent.status === true) return true;
          }
        }
      } catch (e) {}
      return false;
    }

    // Usercentrics v3 (window.__ucCmp) — Promise-based; resolves and calls
    // onGiven() if the service matching serviceName has consent. Best-effort:
    // v3 indexes by serviceId, so we match on whichever name-ish field is
    // present (confirm exact field against the store's real UC version).
    var ucV3InFlight = false;
    function checkUsercentricsV3(serviceName, onGiven) {
      if (!serviceName || ucV3InFlight) return; // guard: one getConsentDetails() at a time
      try {
        var cmp = window.__ucCmp;
        if (!cmp || typeof cmp.getConsentDetails !== 'function') return;
        var p = cmp.getConsentDetails();
        if (!p || typeof p.then !== 'function') return;
        ucV3InFlight = true;
        p.then(function (details) {
          ucV3InFlight = false;
          try {
            var services = details && details.services;
            if (!services) return;
            for (var key in services) {
              if (!Object.prototype.hasOwnProperty.call(services, key)) continue;
              var svc = services[key];
              if (!svc || !svc.consent || svc.consent.given !== true) continue;
              var name = svc.name || svc.dataProcessor || (svc.label && svc.label.name);
              if (name === serviceName) { onGiven(); return; }
            }
          } catch (e) {}
        })['catch'](function () { ucV3InFlight = false; });
      } catch (e) { ucV3InFlight = false; }
    }

    function isConsented(serviceName) {
      return isShopifyConsented() || isUsercentricsConsented(serviceName);
    }

    function gateOnConsent(serviceName, onConsent) {
      var fired = false;
      var pollTimer = null;
      var pollCount = 0;
      // Version-agnostic fallback poll. Kept generous (~10 min) because it's the
      // only late-consent path that does NOT depend on the UC event names below
      // being correct for the merchant's Usercentrics version. Event listeners
      // stay armed after polling stops, so an even-later Accept still fires.
      var POLL_INTERVAL_MS = 2000;
      var MAX_POLLS = 300;
      var UC_EVENTS = ['UC_UI_INITIALIZED', 'UC_UI_CMP_EVENT', 'ucEvent'];

      function grant() {
        if (fired) return;
        fired = true;
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        document.removeEventListener('visitorConsentCollected', recheck);
        for (var i = 0; i < UC_EVENTS.length; i++) window.removeEventListener(UC_EVENTS[i], recheck);
        console.log(FLOW + ' theme consent granted -> loading widget');
        onConsent();
      }

      function tryLoad() {
        if (fired) return;
        checkUsercentricsV3(serviceName, function () { grant(); });
        if (isConsented(serviceName)) grant();
      }

      function recheck() { tryLoad(); }

      function boot() {
        tryLoad();
        if (fired) return;
        // Subscribe for late consent (visitor accepts after page load).
        document.addEventListener('visitorConsentCollected', recheck);
        for (var i = 0; i < UC_EVENTS.length; i++) window.addEventListener(UC_EVENTS[i], recheck);
        // Bounded polling fallback for CMPs whose events we don't catch and for
        // the v3 async read. Listeners stay attached after polling stops so a
        // very-late Accept still fires.
        pollTimer = setInterval(function () {
          pollCount++;
          tryLoad();
          if (fired || pollCount >= MAX_POLLS) {
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          }
        }, POLL_INTERVAL_MS);
      }

      console.log(FLOW + ' theme cmpEmbed enabled -> gating widget on consent service=' + serviceName);
      if (window.Shopify && window.Shopify.customerPrivacy) {
        boot();
      } else if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
        window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function () { boot(); });
      } else {
        // Shopify object not ready yet; events/polling will catch up.
        boot();
      }
    }

    if (window.__magnamateLoaderScheduled) {
      console.log(FLOW + ' theme skip already scheduled');
      return;
    }
    window.__magnamateLoaderScheduled = true;

    var shopDomain = 'more-nutritiondev.myshopify.com';
    var apiUrl = 'https://app.magnamate.de/api/platform/shopify/chatbot?shop=' + encodeURIComponent(shopDomain);
    console.log(FLOW + ' theme FETCH CHO DOMAIN: ' + shopDomain);
    console.log(FLOW + ' theme fetch chatbot shop=' + shopDomain + ' url=' + apiUrl);

    fetch(apiUrl)
      .then(function(response) {
        console.log(FLOW + ' theme chatbot response status=' + response.status + ' ok=' + response.ok);
        if (!response.ok) return null;
        return response.json();
      })
      .then(function(data) {
        if (data && data.chatbotId) {
          console.log(FLOW + ' theme chatbotId from API=' + data.chatbotId + ' agentUrl=' + (data.agentUrl || '(default)'));
          var cmp = data.cmpEmbed || { enabled: false };
          if (cmp.enabled) {
            // MAGNA-710: hold the inject until cookie consent is granted.
            gateOnConsent(cmp.serviceName, function() {
              loadChatbotWithId(data.chatbotId, data.agentUrl);
            });
          } else {
            loadChatbotWithId(data.chatbotId, data.agentUrl);
          }
        } else {
          console.log(FLOW + ' theme no chatbotId in response data=' + (data ? JSON.stringify(data) : 'null'));
        }
      })
      .catch(function(err) {
        console.warn(FLOW + ' theme fetch error', err);
        console.warn('magnamate: Could not load chatbot configuration');
        window.__magnamateLoaderScheduled = false;
      });
  })();
</script>


